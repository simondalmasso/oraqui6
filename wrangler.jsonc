{
  "name": "oraqui6",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "b21fa81d12acb663798f9f7c51801955",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ORAQUI6_SYNC",
      "id": "3ea4b311af2c4d8faed8a80eca91ec4a"
    }
  ],
  "triggers": {
    "crons": [
      "15 2 * * 1,4"
    ]
  },
  "observability": {
    "enabled": true
  }
}
